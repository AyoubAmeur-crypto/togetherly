# Togetherly Environment Variables Example
# Official Canonical Production Domain
NEXT_PUBLIC_SITE_URL=https://gettogetherly.tech

# Google Search Console Verification Token (obtained from Google Search Console)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Togetherly WhatsApp Help / Questions (International format without '+' or spaces, e.g. 15551234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Email Subscription -> Google Sheets Integration
# Method 1 (Recommended): Google Apps Script Web App URL connected to your subscriber Google Sheet
GOOGLE_SHEETS_WEBHOOK_URL=

# Method 2 (Alternative): Google Service Account credentials with edit access to your subscriber sheet
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

